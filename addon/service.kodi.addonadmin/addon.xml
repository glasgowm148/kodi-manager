<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.kodi.addonadmin" name="Kodi Manager" version="0.5.1" provider-name="Kodi Manager contributors">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.service" library="resources/lib/service.py"/>
  <extension point="xbmc.python.pluginsource" library="resources/lib/widget_plugin.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">LAN-only Kodi management dashboard</summary>
    <description lang="en_GB">Local authenticated dashboard for inspecting, editing, installing local ZIPs, reading logs, and backing up Kodi add-on configuration.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
